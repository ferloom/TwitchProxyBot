<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TwitchProxyBot" Width="1180" Height="800" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Secondary" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="SettingRow" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="MinHeight" Value="68"/>
      <Setter Property="Padding" Value="16,12"/>
    </Style>

    <!-- Przyciski -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ControlFill}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource ControlPressed}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Accent" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{DynamicResource AccentFill}" CornerRadius="4" Padding="14,6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource AccentHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource AccentPressed}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Caption" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource SubtleHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource SubtlePressed}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource Caption}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent">
              <ContentPresenter x:Name="C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#C42B1C"/>
                <Setter TargetName="C" Property="TextElement.Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="#B3C42B1C"/>
                <Setter TargetName="C" Property="TextElement.Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Nawigacja -->
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Nav"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="Margin" Value="4,1"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Height="36" Background="Transparent">
              <Border x:Name="Bg" CornerRadius="4" Background="Transparent"/>
              <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Background="{DynamicResource AccentFill}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="PillScale" ScaleY="0.3"/></Border.RenderTransform>
              </Border>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource Icons}" FontSize="16" Width="16" Margin="14,0,14,0" VerticalAlignment="Center"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtlePressed}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleHover}"/>
                <Setter TargetName="Pill" Property="Opacity" Value="1"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY" To="0.3" Duration="0:0:0.1"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Pole tekstowe -->
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentFill}"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border x:Name="B" Background="{DynamicResource InputFill}" BorderBrush="{DynamicResource ControlStroke}" BorderThickness="1" CornerRadius="4">
                <DockPanel Margin="10,0">
                  <TextBlock DockPanel.Dock="Left" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                  <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"/>
                </DockPanel>
              </Border>
              <Border x:Name="Line" Height="1" VerticalAlignment="Bottom" Margin="1,0" CornerRadius="0,0,4,4" Background="{DynamicResource TextTertiary}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource InputFocus}"/>
                <Setter TargetName="Line" Property="Background" Value="{DynamicResource AccentFill}"/>
                <Setter TargetName="Line" Property="Height" Value="2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Przelacznik -->
    <Style TargetType="CheckBox">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <TextBlock x:Name="L" Text="{DynamicResource S_Off}" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
              <Grid Width="40" Height="20">
                <Border x:Name="T" CornerRadius="10" Background="{DynamicResource InputFill}" BorderBrush="{DynamicResource TextSecondary}" BorderThickness="1"/>
                <Ellipse x:Name="K" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0" Fill="{DynamicResource TextSecondary}">
                  <Ellipse.RenderTransform><TranslateTransform x:Name="KT"/></Ellipse.RenderTransform>
                </Ellipse>
              </Grid>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="L" Property="Text" Value="{DynamicResource S_On}"/>
                <Setter TargetName="T" Property="Background" Value="{DynamicResource AccentFill}"/>
                <Setter TargetName="T" Property="BorderBrush" Value="{DynamicResource AccentFill}"/>
                <Setter TargetName="K" Property="Fill" Value="{DynamicResource OnAccent}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KT" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="K" Property="RenderTransformOrigin" Value="0.5,0.5"/><Setter TargetName="K" Property="Width" Value="14"/><Setter TargetName="K" Property="Height" Value="14"/><Setter TargetName="K" Property="Margin" Value="3,0,0,0"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Lista rozwijana -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="B" Background="{DynamicResource ControlFill}" BorderBrush="{DynamicResource ControlStroke}" BorderThickness="1" CornerRadius="4">
              <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextSecondary}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource ControlPressed}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="MinWidth" Value="160"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Style="{StaticResource ComboToggle}" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter IsHitTestVisible="False" Margin="11,0,34,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" HorizontalOffset="-12" PopupAnimation="Fade" Focusable="False" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <Border Margin="12,4,12,18" Padding="4" CornerRadius="8" Background="{DynamicResource PopupFill}" BorderBrush="{DynamicResource ControlStroke}" BorderThickness="1"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.28"/></Border.Effect>
                  <ItemsPresenter/>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Grid Margin="0,1">
              <Border x:Name="B" CornerRadius="4" Background="Transparent"/>
              <Border x:Name="P" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Background="{DynamicResource AccentFill}" Visibility="Collapsed"/>
              <ContentPresenter Margin="12,6" TextElement.Foreground="{DynamicResource TextPrimary}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource SubtleHover}"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource SubtleHover}"/>
                <Setter TargetName="P" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Suwak -->
    <Style x:Key="SliderFill" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="{DynamicResource AccentFill}"/></Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderRest" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="{DynamicResource TrackFill}"/></Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderThumb" TargetType="Thumb">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid Width="20" Height="20">
              <Ellipse Fill="{DynamicResource ThumbFill}" Stroke="{DynamicResource ControlStroke}"/>
              <Ellipse x:Name="I" Width="12" Height="12" Fill="{DynamicResource AccentFill}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="I" Property="Width" Value="14"/><Setter TargetName="I" Property="Height" Value="14"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="I" Property="Width" Value="10"/><Setter TargetName="I" Property="Height" Value="10"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="24" Background="Transparent">
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderRest}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource SliderThumb}"/></Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Pasek postepu -->
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource ControlStroke}"/>
              <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left" Background="{DynamicResource AccentFill}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Pasek przewijania -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="B" Width="3" CornerRadius="1.5" HorizontalAlignment="Center" Background="{DynamicResource TextTertiary}"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Width" Value="6"/><Setter TargetName="B" Property="CornerRadius" Value="3"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Pasek tytulu -->
    <Grid Grid.Row="0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
        <TextBlock Text="TwitchProxyBot v1.0" FontSize="12" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button x:Name="MinBtn" Style="{StaticResource Caption}" Content="&#xE921;" AutomationProperties.Name="{DynamicResource S_Minimize}"/>
        <Button x:Name="MaxBtn" Style="{StaticResource Caption}" Content="&#xE922;" AutomationProperties.Name="{DynamicResource S_Maximize}"/>
        <Button x:Name="CloseBtn" Style="{StaticResource CaptionClose}" Content="&#xE8BB;" AutomationProperties.Name="{DynamicResource S_Close}"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Panel nawigacji -->
      <DockPanel x:Name="NavPane" Width="240" ClipToBounds="True" Margin="0,0,0,4">
        <Button x:Name="NavToggle" DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="4,0,0,6" Width="44" Height="36" Background="Transparent" BorderBrush="Transparent" Padding="0" AutomationProperties.Name="{DynamicResource S_CollapseNav}">
          <TextBlock Text="&#xE700;" Style="{StaticResource Glyph}"/>
        </Button>
        <StackPanel DockPanel.Dock="Bottom">
          <RadioButton x:Name="NavInfo" Style="{StaticResource NavItem}" Tag="&#xE946;" Content="{DynamicResource S_Info}"/>
          <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="{DynamicResource S_Settings}"/>
        </StackPanel>
        <StackPanel>
          <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="{DynamicResource S_Home}" IsChecked="True"/>
          <RadioButton x:Name="NavBots" Style="{StaticResource NavItem}" Tag="&#xE99A;" Content="{DynamicResource S_Bots}"/>
          <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" Tag="&#xE81C;" Content="{DynamicResource S_History}"/>
        </StackPanel>
      </DockPanel>

      <!-- Warstwa tresci -->
      <Border Grid.Column="1" Background="{DynamicResource LayerFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0" ClipToBounds="True">
        <Grid>

          <!-- PANEL GLOWNY -->
          <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="32,24,32,28">
              <DockPanel Margin="0,0,0,20">
                <Border x:Name="StatusPill" DockPanel.Dock="Right" VerticalAlignment="Center" Padding="12,5" CornerRadius="14" Background="{DynamicResource ControlFill}" BorderThickness="1" BorderBrush="{DynamicResource ControlStroke}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource TextTertiary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="{DynamicResource S_Idle}" FontSize="12" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <TextBlock Text="{DynamicResource S_Home}" Style="{StaticResource PageTitle}"/>
              </DockPanel>

              <Border x:Name="InfoBar" Visibility="Collapsed" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource CardStroke}" Background="{DynamicResource SuccessBg}" Padding="14,11" Margin="0,0,0,12">
                <DockPanel>
                  <TextBlock Text="&#xE930;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Success}" Margin="0,0,12,0"/>
                  <TextBlock x:Name="InfoBarText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>

              <UniformGrid Columns="4" Margin="-4,0,-4,12">
                <Border Style="{StaticResource Card}" Margin="4,0">
                  <StackPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="&#xE99A;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentText}"/><TextBlock Text="{DynamicResource S_ActiveBots}" Style="{StaticResource Secondary}" VerticalAlignment="Center"/></DockPanel>
                    <TextBlock x:Name="StatBots" Text="0" Style="{StaticResource StatValue}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0">
                  <StackPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="&#xE7B3;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentText}"/><TextBlock Text="{DynamicResource S_Viewers}" Style="{StaticResource Secondary}" VerticalAlignment="Center"/></DockPanel>
                    <TextBlock x:Name="StatViewers" Text="0" Style="{StaticResource StatValue}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0">
                  <StackPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="&#xEB51;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentText}"/><TextBlock Text="{DynamicResource S_NewFollowers}" Style="{StaticResource Secondary}" VerticalAlignment="Center"/></DockPanel>
                    <TextBlock x:Name="StatFollowers" Text="0" Style="{StaticResource StatValue}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0">
                  <StackPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="&#xE774;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentText}"/><TextBlock Text="{DynamicResource S_ProxyOnline}" Style="{StaticResource Secondary}" VerticalAlignment="Center"/></DockPanel>
                    <TextBlock x:Name="StatProxy" Text="0" Style="{StaticResource StatValue}"/>
                  </StackPanel>
                </Border>
              </UniformGrid>

              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="320"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource S_NewCampaign}" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>
                    <StackPanel x:Name="CampaignInputs">
                      <TextBlock Text="{DynamicResource S_Channel}" Style="{StaticResource Secondary}" Margin="0,0,0,6"/>
                      <TextBox x:Name="ChannelBox" Tag="twitch.tv/" MaxLength="25" AutomationProperties.Name="{DynamicResource S_Channel}"/>
                      <TextBlock x:Name="ChannelError" Text="{DynamicResource S_ChannelError}" Style="{StaticResource Secondary}" Foreground="{DynamicResource Critical}" Margin="0,5,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                      <TextBlock Text="{DynamicResource S_BotKind}" Style="{StaticResource Secondary}" Margin="0,14,0,6"/>
                      <ComboBox x:Name="KindBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="{DynamicResource S_Viewers}"/>
                        <ComboBoxItem Content="{DynamicResource S_Followers}"/>
                        <ComboBoxItem Content="{DynamicResource S_Chat}"/>
                      </ComboBox>

                      <DockPanel Margin="0,14,0,2">
                        <TextBlock x:Name="CountLabel" DockPanel.Dock="Right" Text="500" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource S_BotCount}" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                      </DockPanel>
                      <Slider x:Name="CountSlider" Minimum="10" Maximum="10000" Value="500" TickFrequency="10" IsSnapToTickEnabled="True" LargeChange="500" SmallChange="10"/>

                      <DockPanel Margin="0,12,0,0">
                        <CheckBox x:Name="GradualToggle" DockPanel.Dock="Right" IsChecked="True" AutomationProperties.Name="{DynamicResource S_Gradual}"/>
                        <TextBlock Text="{DynamicResource S_Gradual}" VerticalAlignment="Center"/>
                      </DockPanel>
                      <DockPanel Margin="0,10,0,0">
                        <CheckBox x:Name="RotateToggle" DockPanel.Dock="Right" IsChecked="True" AutomationProperties.Name="{DynamicResource S_Rotation}"/>
                        <TextBlock Text="{DynamicResource S_Rotation}" VerticalAlignment="Center"/>
                      </DockPanel>
                    </StackPanel>

                    <Button x:Name="StartBtn" Style="{StaticResource Accent}" Margin="0,18,0,0" AutomationProperties.Name="{DynamicResource S_Start}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource S_Start}"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="StopBtn" Margin="0,18,0,0" MinHeight="36" Visibility="Collapsed" AutomationProperties.Name="{DynamicResource S_Stop}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource S_Stop}"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                      <TextBlock x:Name="ChartValue" DockPanel.Dock="Right" Text="0" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold"/>
                      <StackPanel>
                        <TextBlock x:Name="ChartTitle" Text="{DynamicResource S_ChartViewers}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{DynamicResource S_Last60}" Style="{StaticResource Secondary}" Margin="0,2,0,0"/>
                      </StackPanel>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                      <DockPanel Margin="0,0,0,7">
                        <TextBlock x:Name="ProgressPct" DockPanel.Dock="Right" Text="0%" Style="{StaticResource Secondary}"/>
                        <TextBlock x:Name="PhaseText" Text="{DynamicResource S_PhaseWaiting}" Style="{StaticResource Secondary}"/>
                      </DockPanel>
                      <ProgressBar x:Name="Progress" Minimum="0" Maximum="100"/>
                    </StackPanel>
                    <Grid Margin="0,12,0,0" MinHeight="200">
                      <Canvas x:Name="ChartCanvas" Background="Transparent" ClipToBounds="True"/>
                      <TextBlock x:Name="ChartEmpty" Text="{DynamicResource S_ChartEmpty}" Style="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                  </DockPanel>
                </Border>
              </Grid>

              <Border Style="{StaticResource Card}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="{DynamicResource S_Log}" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                  <ScrollViewer x:Name="LogScroll" Height="150" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl x:Name="LogList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,1"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- BOTY -->
          <DockPanel x:Name="PageBots" Margin="32,24,32,28" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
              <TextBox x:Name="BotSearch" DockPanel.Dock="Right" Width="240" VerticalAlignment="Center" Tag="{DynamicResource S_SearchPrefix}" AutomationProperties.Name="{DynamicResource S_SearchBot}"/>
              <StackPanel>
                <TextBlock Text="{DynamicResource S_Bots}" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="BotSummary" Text="{DynamicResource S_NoActiveBots}" Style="{StaticResource Secondary}" Margin="0,4,0,0"/>
              </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource Card}" Padding="0">
              <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,12,28,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="120"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource S_Name}" Style="{StaticResource Secondary}"/>
                  <TextBlock Grid.Column="1" Text="{DynamicResource S_Country}" Style="{StaticResource Secondary}"/>
                  <TextBlock Grid.Column="2" Text="Proxy" Style="{StaticResource Secondary}"/>
                  <TextBlock Grid.Column="3" Text="Ping" Style="{StaticResource Secondary}"/>
                  <TextBlock Grid.Column="4" Text="{DynamicResource S_Status}" Style="{StaticResource Secondary}"/>
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Divider}"/>
                <Grid>
                  <ScrollViewer VerticalScrollBarVisibility="Visible" Focusable="False">
                    <ItemsControl x:Name="BotList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="16,8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="2*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Country}" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Proxy}" FontFamily="{StaticResource Mono}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Grid.Column="3" Text="{Binding Ping}" Foreground="{DynamicResource TextSecondary}"/>
                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                              <Ellipse Width="8" Height="8" Fill="{DynamicResource Success}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                              <TextBlock Text="{DynamicResource S_BotActive}"/>
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <StackPanel x:Name="BotEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE99A;" Style="{StaticResource Glyph}" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiary}"/>
                    <TextBlock Text="{DynamicResource S_NoBots}" Margin="0,12,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                  </StackPanel>
                </Grid>
              </DockPanel>
            </Border>
          </DockPanel>

          <!-- HISTORIA -->
          <DockPanel x:Name="PageHistory" Margin="32,24,32,28" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
              <Button x:Name="HistoryClear" DockPanel.Dock="Right" Content="{DynamicResource S_Clear}" VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource S_History}" Style="{StaticResource PageTitle}"/>
            </DockPanel>
            <Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl x:Name="HistoryList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Card}" Margin="0,0,0,4" Padding="16,12">
                        <DockPanel>
                          <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Count}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding Duration}" Style="{StaticResource Secondary}" HorizontalAlignment="Right"/>
                          </StackPanel>
                          <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Success}" Margin="0,0,14,0"/>
                          <StackPanel>
                            <TextBlock Text="{Binding Channel}"/>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" Margin="0,2,0,0"/>
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <StackPanel x:Name="HistoryEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE81C;" Style="{StaticResource Glyph}" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiary}"/>
                <TextBlock Text="{DynamicResource S_HistoryEmpty}" Margin="0,12,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
              </StackPanel>
            </Grid>
          </DockPanel>

          <!-- USTAWIENIA -->
          <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Focusable="False">
            <StackPanel Margin="32,24,32,28">
              <TextBlock Text="{DynamicResource S_Settings}" Style="{StaticResource PageTitle}" Margin="0,0,0,20"/>

              <TextBlock Text="{DynamicResource S_Appearance}" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right">
                    <ComboBoxItem Content="Polski"/>
                    <ComboBoxItem Content="English"/>
                  </ComboBox>
                  <TextBlock Text="&#xF2B7;" Style="{StaticResource Glyph}" Margin="0,0,16,0"/>
                  <StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource S_Language}"/><TextBlock Text="{DynamicResource S_LanguageDesc}" Style="{StaticResource Secondary}"/></StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" SelectedIndex="0">
                    <ComboBoxItem Content="{DynamicResource S_ThemeSystem}"/>
                    <ComboBoxItem Content="{DynamicResource S_ThemeLight}"/>
                    <ComboBoxItem Content="{DynamicResource S_ThemeDark}"/>
                  </ComboBox>
                  <TextBlock Text="&#xE790;" Style="{StaticResource Glyph}" Margin="0,0,16,0"/>
                  <StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource S_Theme}"/><TextBlock Text="{DynamicResource S_ThemeDesc}" Style="{StaticResource Secondary}"/></StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <ComboBox x:Name="BackdropBox" DockPanel.Dock="Right" SelectedIndex="0">
                    <ComboBoxItem Content="Mica"/>
                    <ComboBoxItem Content="Mica Alt"/>
                    <ComboBoxItem Content="Acrylic"/>
                  </ComboBox>
                  <TextBlock Text="&#xE771;" Style="{StaticResource Glyph}" Margin="0,0,16,0"/>
                  <StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource S_Backdrop}"/><TextBlock Text="{DynamicResource S_BackdropDesc}" Style="{StaticResource Secondary}"/></StackPanel>
                </DockPanel>
              </Border>

              <TextBlock Text="{DynamicResource S_Network}" Style="{StaticResource CardTitle}" Margin="0,16,0,8"/>
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <ComboBox x:Name="RegionBox" DockPanel.Dock="Right" SelectedIndex="0">
                    <ComboBoxItem Content="{DynamicResource S_RegionAuto}"/>
                    <ComboBoxItem Content="{DynamicResource S_RegionEurope}"/>
                    <ComboBoxItem Content="{DynamicResource S_RegionNA}"/>
                    <ComboBoxItem Content="{DynamicResource S_RegionAsia}"/>
                  </ComboBox>
                  <TextBlock Text="&#xE774;" Style="{StaticResource Glyph}" Margin="0,0,16,0"/>
                  <StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource S_Region}"/><TextBlock Text="{DynamicResource S_RegionDesc}" Style="{StaticResource Secondary}"/></StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <CheckBox DockPanel.Dock="Right" IsChecked="True"/>
                  <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" Margin="0,0,16,0"/>
                  <StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource S_Encryption}"/><TextBlock Text="{DynamicResource S_EncryptionDesc}" Style="{StaticResource Secondary}"/></StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <CheckBox DockPanel.Dock="Right"/>
                  <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" Margin="0,0,16,0"/>
                  <StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource S_Aggressive}"/><TextBlock Text="{DynamicResource S_AggressiveDesc}" Style="{StaticResource Secondary}"/></StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- INFORMACJE -->
          <ScrollViewer x:Name="PageInfo" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Focusable="False">
            <StackPanel Margin="32,24,32,28">
              <TextBlock Text="{DynamicResource S_Info}" Style="{StaticResource PageTitle}" Margin="0,0,0,20"/>
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="v1.0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                  <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" Margin="0,0,16,0"/>
                  <StackPanel VerticalAlignment="Center"><TextBlock Text="TwitchProxyBot"/><TextBlock Text="{DynamicResource S_AppVersion}" Style="{StaticResource Secondary}"/></StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" Margin="0,0,16,0"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource S_SimTitle}"/>
                    <TextBlock Text="{DynamicResource S_SimText}" Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
